# Copy to .env and fill with your own values.
# Never commit real secrets, real IDs, or real URLs to Git.

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Comma-separated chat/user IDs. EMPTY = the bot rejects everyone (default-deny).
TELEGRAM_CHAT_ID=123456789,987654321
# Optional: the student's own chat ID (evening nudge goes here only).
TELEGRAM_STUDENT_CHAT_ID=123456789
TELEGRAM_MAX_RESPONSE_CHARS=1800

# --- Google Sheets (read + write via Service Account) ---
# Full content of the service-account JSON key file, or its Base64 encoding.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# The sheet ID (the long token inside the sheet URL):
GOOGLE_SHEET_ID=your-google-sheet-id
SHEET_CACHE_TTL_SECONDS=60

# Read-only fallbacks (optional, when no Service Account is configured):
# AYMAN_STUDY_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
# AYMAN_STUDY_SHEET=C:/path/to/Study Mentor OS - Ayman.xlsx

# --- Scheduling (timezone + clock times) ---
TIMEZONE=Asia/Riyadh
DAILY_REPORT_TIME=21:00
EVENING_NUDGE_TIME=20:00
REMINDER_MINUTES_BEFORE=60

# --- AI backends ---
AI_BACKEND=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# --- Optional parent email (Telegram-only by default) ---
PARENT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
REPORT_LABEL=تقرير اليوم

# --- Local data dir (legacy appointments fallback; containers use the sheet) ---
# AYMAN_DATA_DIR=
