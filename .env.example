# Copy to .env and fill with your own values.
# Do not commit real secrets to Git.

# Gmail / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-gmail@example.com

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Comma-separated IDs; both the son and father receive access/reports.
TELEGRAM_CHAT_ID=8778090214,7398495644

# Parent / report recipient
PARENT_EMAIL=parent@example.com
REPORT_LABEL=تقرير اليوم

# Study workbook (optional)
AYMAN_STUDY_SHEET=C:/path/to/Study Mentor OS — Ayman.xlsx
# Alternate variable name:
STUDY_SHEET_PATH=C:/path/to/Study Mentor OS — Ayman.xlsx
# Public Google Sheet URL (used when no local workbook path is set):
AYMAN_STUDY_SHEET_URL=https://docs.google.com/spreadsheets/d/1g7NsctkNigecJVVewBgdQeO9PXPceejg702MW60kQvY/edit

# AWS Bedrock (optional)
AI_BACKEND=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Gemini (optional alternative AI backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
